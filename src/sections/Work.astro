---
import SectionHead from '../components/SectionHead.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getFeatured } from '../lib/projects';
import { codeWork } from '../data/site';

const projects = await getFeatured();

const groups = [
  {
    via: 'direct',
    title: 'Client work',
    note: 'Designed, built and set up for marketing, working directly with the business owner.',
  },
  {
    via: 'own',
    title: 'My own ventures',
    note: 'Sites and software for IP Venture Studio, which I co-founded in 2026.',
  },
  {
    via: 'agency',
    title: 'Agency work',
    note: 'Built as a developer at an Adelaide marketing agency.',
  },
]
  .map((g) => ({ ...g, projects: projects.filter((p) => p.data.via === g.via) }))
  .filter((g) => g.projects.length > 0);

// Headings only help when there's more than one group.
const showHeads = groups.length > 1;
---

<section class="section" id="work" aria-labelledby="work-title">
  <div class="wrap">
    <SectionHead index="01" eyebrow="work" title="Selected work" id="work-title">
      <p>Websites and software, from the first brief through to launch. Each one opens a short case study.</p>
    </SectionHead>

    {
      groups.map((g) => (
        <div class="group">
          {showHeads && (
            <div class="group-head">
              <h3>{g.title}</h3>
              <p>{g.note}</p>
            </div>
          )}
          <ul class:list={['grid', { 'grid--one': g.projects.length === 1, 'grid--pair': g.projects.length === 2 }]} role="list">
            {g.projects.map((project) => (
              <li>
                <ProjectCard project={project} wide={g.projects.length === 1} />
              </li>
            ))}
          </ul>
        </div>
      ))
    }

    <div class="code">
      <h3 class="eyebrow"><span class="slash" aria-hidden="true">&lt;/&gt;</span> Code: work that isn’t a site design</h3>
      <ul role="list" class="code-list">
        {
          codeWork.map((item) => (
            <li>
              <h4>{item.title}</h4>
              <p>{item.body}</p>
              <p class="tags mono">{item.tags.join(' · ')}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .group + .group { margin-top: clamp(3rem, 6vw, 4.5rem); }
  .group-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 1.25rem;
    margin-bottom: 1.5rem;
    padding-bottom: 0.9rem;
    border-bottom: 1px solid var(--line);
  }
  .group-head h3 { font-size: var(--step-1); }
  .group-head p { color: var(--muted); font-size: 0.95rem; }

  .grid {
    display: grid;
    gap: clamp(1.25rem, 2.5vw, 1.75rem);
    grid-template-columns: 1fr;
  }
  .grid > li { display: grid; }
  @media (min-width: 44em) {
    .grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 75em) {
    .grid { grid-template-columns: repeat(3, 1fr); }
  }
  /* a single project gets the full width; a pair stays two-up */
  .grid--one { grid-template-columns: 1fr !important; }
  @media (min-width: 75em) {
    .grid--pair { grid-template-columns: repeat(2, 1fr); }
  }

  .code {
    margin-top: clamp(3rem, 6vw, 4.5rem);
    padding-top: 1.75rem;
    border-top: 1px dashed var(--line-strong);
  }
  .code h3 { margin-bottom: 1.25rem; }
  .code-list {
    display: grid;
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }
  @media (min-width: 52em) {
    .code-list { grid-template-columns: repeat(3, 1fr); }
  }
  .code-list li {
    display: grid;
    gap: 0.45rem;
    align-content: start;
    padding: 1.25rem 1.35rem 1.4rem;
    background: var(--ink-2);
  }
  h4 { font-size: var(--step-0); font-weight: 600; }
  .code-list p { color: var(--sage); font-size: 0.95rem; line-height: 1.55; }
  .code-list .tags { color: var(--teal-bright); font-size: var(--step--1); }
</style>
