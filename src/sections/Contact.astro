---
import SectionHead from '../components/SectionHead.astro';
import Frame from '../components/Frame.astro';
import { contact } from '../data/site';

const prettyUrl = (url: string) => url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');

type Row = { label: string; value: string; href?: string; external?: boolean; todo?: string };
const rows: Row[] = [
  { label: 'email', value: contact.email, href: `mailto:${contact.email}` },
  { label: 'whatsapp', value: contact.whatsapp.display, href: contact.whatsapp.href, external: true },
  contact.linkedin
    ? { label: 'linkedin', value: prettyUrl(contact.linkedin), href: contact.linkedin, external: true }
    : { label: 'linkedin', value: 'Add your profile URL in src/data/site.ts', todo: 'contact: LinkedIn URL' },
];
---

<section class="section contact" id="contact" aria-labelledby="contact-title">
  <div class="wrap inner">
    <Frame corners={['tl', 'br']} />
    <SectionHead index="05" eyebrow="contact" title="So, what will you ask?" id="contact-title">
      <p>Tell me about the site you need, or just say hello.</p>
    </SectionHead>
    <ul class="links" role="list">
      {
        rows.map((r) => (
          <li hidden={!r.href && !import.meta.env.DEV} data-todo={!r.href && !import.meta.env.DEV ? r.todo : undefined}>
            {r.href ? (
              <a
                href={r.href}
                target={r.external ? '_blank' : undefined}
                rel={r.external ? 'noopener' : undefined}
              >
                <span class="label mono">{r.label}</span>
                <span class="value">{r.value}</span>
                <span class="go" aria-hidden="true">{r.external ? '↗' : '→'}</span>
                {r.external && <span class="visually-hidden">(opens in a new tab)</span>}
              </a>
            ) : (
              <div class="row-todo todo" data-todo={r.todo}>
                <span class="label mono">{r.label}</span>
                <span class="value">{r.value}</span>
              </div>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .inner {
    position: relative;
    display: grid;
    padding: clamp(2.5rem, 6vw, 4.5rem) clamp(0.9rem, 5vw, 4rem);
    --frame-inset: 0;
    --frame-colour: var(--teal-bright);
  }
  @media (min-width: 60em) {
    .inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
      gap: 4rem;
      align-items: center;
    }
    .inner :global(.head) { margin-bottom: 0; }
  }
  .links {
    border-top: 1px solid var(--line-strong);
    max-width: 48rem;
  }
  .links li { border-bottom: 1px solid var(--line-strong); }
  .links a,
  .row-todo {
    display: grid;
    grid-template-columns: 5.5rem 1fr auto;
    align-items: center;
    gap: 1rem;
    min-height: 3.75rem;
    padding: 0.85rem 0.25rem;
    text-decoration: none;
  }
  @media (min-width: 40em) {
    .links a, .row-todo { grid-template-columns: 8rem 1fr auto; }
  }
  .row-todo { border-width: 1px; margin-block: 0.4rem; padding-inline: 0.6rem; }
  .label { color: var(--muted); font-size: var(--step--1); }
  .value {
    color: var(--paper);
    font-size: var(--step-1);
    font-weight: 500;
    overflow-wrap: anywhere;
    transition: color 0.2s;
  }
  .row-todo .value { color: var(--lime); font-size: var(--step--1); font-weight: 400; }
  .go {
    color: var(--teal-bright);
    font-size: var(--step-1);
    transition: transform 0.25s var(--ease), color 0.2s;
  }
  .links a:hover .value { color: var(--lime); }
  .links a:hover .go { color: var(--lime); transform: translateX(4px); }
</style>
