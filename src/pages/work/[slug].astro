---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import Device from '../../components/Device.astro';
import Frame from '../../components/Frame.astro';
import { getFeatured, type ProjectView } from '../../lib/projects';

export const getStaticPaths = (async () => {
  const projects = await getFeatured();
  const many = projects.length > 1;
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: {
      project,
      prev: many ? projects[(i - 1 + projects.length) % projects.length] : undefined,
      next: many ? projects[(i + 1) % projects.length] : undefined,
    },
  }));
}) satisfies GetStaticPaths;

interface Props {
  project: ProjectView;
  prev?: ProjectView;
  next?: ProjectView;
}

const { project: p, prev, next } = Astro.props;
const d = p.data;
const host = d.url ? new URL(d.url).hostname.replace(/^www\./, '') : undefined;
const shotAlt = (kind: string) =>
  `${p.title} website on ${kind}: the home page as it looks on a ${kind === 'desktop' ? 'laptop or desktop screen' : 'phone'}`;
---

<Base
  title={`${p.title}: ${d.platform} case study · Joel Nottle`}
  description={`${d.summary} Case study by Joel Nottle, web designer and developer.`}
  home={false}
  type="article"
>
  <article class="case" data-todo={d.draft ? `${p.id}: copy still marked draft (check it, then set draft: false)` : undefined}>
    <header class="wrap intro">
      <p class="crumb mono"><a href="/#work">work</a> <span aria-hidden="true">/</span> {p.id}</p>
      <h1>{p.title}</h1>
      <p class="brief">{d.brief}</p>

      <dl class="facts">
        <div><dt class="mono">{d.via === 'own' ? 'Project' : 'Client'}</dt><dd>{d.clientType}</dd></div>
        <div><dt class="mono">Location</dt><dd>{d.location}</dd></div>
        <div><dt class="mono">Platform</dt><dd>{d.platform}</dd></div>
        <div><dt class="mono">My role</dt><dd>{d.role}</dd></div>
      </dl>
    </header>

    <div class="wrap screens-wrap">
      <div class="screens">
        <Frame corners={['tl', 'br']} />
        <Device
          kind="desktop"
          image={p.desktop}
          alt={shotAlt('desktop')}
          sizes="(min-width: 75em) 820px, 72vw"
          eager
          projectId={p.id}
        />
        <Device
          kind="mobile"
          image={p.mobile}
          alt={shotAlt('mobile')}
          sizes="(min-width: 75em) 250px, 24vw"
          eager
          projectId={p.id}
        />
      </div>
    </div>

    <div class="wrap detail">
      <section aria-labelledby="built-title">
        <h2 id="built-title" class="eyebrow">What I built</h2>
        <ul role="list" class="built">
          {d.built.map((item) => <li>{item}</li>)}
        </ul>
      </section>

      <aside class="side">
        {
          d.outcome && (
            <figure class="outcome">
              <blockquote>
                <p>{d.outcome.quote}</p>
              </blockquote>
              {d.outcome.by && <figcaption class="mono">{d.outcome.by}</figcaption>}
            </figure>
          )
        }
        {
          d.url ? (
            <a class="btn btn-primary" href={d.url} target="_blank" rel="noopener">
              Visit {host} <span class="arrow" aria-hidden="true">↗</span>
              <span class="visually-hidden">(opens in a new tab)</span>
            </a>
          ) : (
            <p class="todo live-todo" data-todo={`${p.id}: live site link`}>
              Live site link: add a url to the project file
            </p>
          )
        }
      </aside>
    </div>

    {
      prev && next && (
        <nav class="wrap pager" aria-label="More case studies">
          <a href={prev.href} class="prev">
            <span class="mono">← previous</span>
            <span class="t">{prev.title}</span>
          </a>
          <a href={next.href} class="next">
            <span class="mono">next →</span>
            <span class="t">{next.title}</span>
          </a>
        </nav>
      )
    }

    <div class:list={['wrap cta', { 'cta--ruled': !(prev && next) }]}>
      <p>Need something like this?</p>
      <a class="btn" href="/#contact">Get in touch <span class="arrow" aria-hidden="true">→</span></a>
    </div>
  </article>
</Base>

<style>
  .intro {
    padding-block: clamp(2.5rem, 7vw, 5rem) clamp(2rem, 4vw, 3rem);
    display: grid;
    gap: 1.1rem;
  }
  .crumb { font-size: var(--step--1); color: var(--muted); }
  .crumb a { color: var(--teal-bright); }
  h1 {
    font-size: var(--step-4);
    letter-spacing: -0.035em;
    max-width: 18ch;
  }
  .brief {
    max-width: 40ch;
    font-size: var(--step-2);
    line-height: 1.35;
    color: var(--mist);
    letter-spacing: -0.01em;
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem 1.5rem;
    margin-top: 1.25rem;
    padding-block: 1.25rem;
    border-block: 1px solid var(--line-strong);
  }
  @media (min-width: 56em) {
    .facts { grid-template-columns: repeat(4, 1fr); }
  }
  dt { font-size: var(--step--1); color: var(--muted); margin-bottom: 0.2rem; }
  dd { color: var(--paper); line-height: 1.4; }

  /* desktop and phone side by side, at every size */
  .screens {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 1fr);
    gap: clamp(0.75rem, 3vw, 2.5rem);
    align-items: end;
    padding: clamp(1rem, 4vw, 3rem);
    border-radius: calc(var(--radius) * 1.5);
    background:
      radial-gradient(80% 90% at 30% 0%, rgb(44 107 103 / 0.25), transparent 70%),
      var(--ink-2);
    border: 1px solid var(--line);
    --frame-inset: -7px;
    --frame-size: clamp(22px, 4vw, 40px);
    --frame-colour: var(--teal-bright);
  }

  .detail {
    display: grid;
    gap: 2.5rem;
    padding-block: clamp(3rem, 7vw, 5rem);
  }
  @media (min-width: 56em) {
    .detail { grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: 4rem; }
  }
  .detail h2 { margin-bottom: 1.1rem; }
  .built { display: grid; gap: 0.15rem; border-top: 1px solid var(--line); }
  .built li {
    position: relative;
    padding: 0.85rem 0 0.85rem 1.9rem;
    border-bottom: 1px solid var(--line);
    font-size: var(--step-1);
    line-height: 1.45;
  }
  .built li::before {
    content: '→';
    position: absolute;
    left: 0.1rem;
    color: var(--lime);
    font-family: var(--mono);
  }
  .side { display: grid; gap: 1.5rem; align-content: start; }
  .outcome {
    padding: 1.25rem 1.4rem;
    border-left: 2px solid var(--lime);
    background: var(--ink-2);
    border-radius: 0 var(--radius) var(--radius) 0;
  }
  .outcome blockquote { font-size: var(--step-1); color: var(--paper); line-height: 1.45; }
  .outcome figcaption { margin-top: 0.75rem; color: var(--muted); font-size: var(--step--1); }
  .side .btn { justify-self: start; }
  .live-todo { padding: 0.8rem 1rem; border-radius: var(--radius); }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-block: 1px solid var(--line-strong);
  }
  .pager a {
    display: grid;
    gap: 0.3rem;
    padding: 1.5rem 0.25rem;
    text-decoration: none;
  }
  .pager .next { text-align: right; border-left: 1px solid var(--line); }
  .pager .mono { color: var(--muted); font-size: var(--step--1); }
  .pager .t { color: var(--paper); font-size: var(--step-1); font-weight: 500; transition: color 0.2s; }
  .pager a:hover .t { color: var(--lime); }

  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: clamp(3rem, 6vw, 4.5rem);
  }
  .cta--ruled { border-top: 1px solid var(--line-strong); }
  .cta p { font-size: var(--step-2); color: var(--paper); font-weight: 600; letter-spacing: -0.02em; }
</style>
