---
/**
 * The jnot.net mark, from brand/jnot-logo-b-reversed.svg (dark-background version).
 * Inline so it can inherit colour tokens and draw itself in.
 */
interface Props {
  /** Draw the strokes in on load. */
  animate?: boolean;
  /** Accessible name. Pass an empty string when the logo is decorative (e.g. inside a labelled link). */
  label?: string;
  class?: string;
}
const { animate = false, label = 'jnot.net', class: className } = Astro.props;
const titleId = `logo-${Math.random().toString(36).slice(2, 8)}`;
---

<svg
  class:list={['logo', { 'logo--draw': animate }, className]}
  viewBox="-90 -72 450 256"
  fill="none"
  stroke-width="24"
  role={label ? 'img' : undefined}
  aria-labelledby={label ? titleId : undefined}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
>
  {label && <title id={titleId}>{label}</title>}
  <!-- brackets: top-left forms the j -->
  <path class="frame" pathLength="1" d="M240,-60 H26 A26,26 0 0 0 0,-34 V62 A26,26 0 0 1 -26,88 H-90" />
  <path class="frame frame--2" pathLength="1" d="M348,50 V146 A26,26 0 0 1 322,172 H184" />
  <!-- not -->
  <g class="ink">
    <path pathLength="1" d="M44,100 V44 A32,32 0 0 1 108,44 V100" />
    <circle pathLength="1" cx="190" cy="50" r="38" />
    <path pathLength="1" d="M272,-30 V62 A26,26 0 0 0 298,88 H316 M260,12 H316" />
  </g>
  <!-- dot net -->
  <g class="small" transform="translate(-90 144) scale(0.4)">
    <g class="accent">
      <circle pathLength="1" cx="50" cy="50" r="38" />
      <path pathLength="1" d="M88,-50 V100" />
      <circle pathLength="1" cx="174" cy="50" r="38" />
      <path pathLength="1" d="M260,-30 V62 A26,26 0 0 0 286,88 H304 M248,12 H304" />
    </g>
    <g class="ink">
      <path pathLength="1" d="M356,100 V44 A32,32 0 0 1 420,44 V100" />
      <path pathLength="1" d="M468,50 H556 M544,50 A38,38 0 1 0 532.87,76.87" />
      <path pathLength="1" d="M592,-30 V62 A26,26 0 0 0 618,88 H636 M580,12 H636" />
    </g>
  </g>
</svg>

<style>
  .logo {
    --logo-frame: var(--teal-bright);
    --logo-ink: var(--paper);
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .frame,
  .accent { stroke: var(--logo-frame); }
  .ink { stroke: var(--logo-ink); }

  @media (prefers-reduced-motion: no-preference) {
    .logo--draw :is(path, circle) {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
      animation: draw 0.9s var(--ease) forwards;
    }
    .logo--draw .frame { animation-duration: 1.1s; }
    .logo--draw .frame--2 { animation-delay: 0.1s; }
    .logo--draw .ink :is(path, circle) { animation-delay: 0.35s; }
    .logo--draw .small :is(path, circle) { animation-delay: 0.6s; animation-duration: 0.7s; }
  }
  @keyframes draw {
    to { stroke-dashoffset: 0; }
  }
</style>
