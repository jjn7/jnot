---
/** Corner brackets, the signature from the holding page. Decorative. */
interface Props {
  /** Which corners to draw. The logo itself uses top-left and bottom-right. */
  corners?: Array<'tl' | 'tr' | 'bl' | 'br'>;
  animate?: boolean;
}
const { corners = ['tl', 'tr', 'bl', 'br'], animate = false } = Astro.props;
---

<div class:list={['frame', { 'frame--draw': animate }]} aria-hidden="true">
  {
    corners.map((c) => (
      <span class={`corner ${c}`}>
        <svg viewBox="0 0 64 64">
          <path d="M2 30 V2 H30" pathLength="1" />
        </svg>
      </span>
    ))
  }
</div>

<style>
  .frame {
    position: absolute;
    inset: var(--frame-inset, clamp(0.75rem, 3vw, 2rem));
    pointer-events: none;
  }
  .corner {
    position: absolute;
    width: var(--frame-size, clamp(28px, 5vw, 56px));
    aspect-ratio: 1;
  }
  .corner svg { width: 100%; height: 100%; overflow: visible; }
  .corner path {
    fill: none;
    stroke: var(--frame-colour, var(--teal));
    stroke-width: 2.5;
    stroke-linecap: square;
    vector-effect: non-scaling-stroke;
  }
  .tl { top: 0; left: 0; }
  .tr { top: 0; right: 0; transform: scaleX(-1); }
  .bl { bottom: 0; left: 0; transform: scaleY(-1); }
  .br { bottom: 0; right: 0; transform: scale(-1, -1); }

  @media (prefers-reduced-motion: no-preference) {
    .frame--draw path {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
      animation: draw 1.1s cubic-bezier(0.6, 0.05, 0.2, 1) forwards;
    }
    .frame--draw .tr path { animation-delay: 0.08s; }
    .frame--draw .bl path { animation-delay: 0.16s; }
    .frame--draw .br path { animation-delay: 0.24s; }
  }
  @keyframes draw {
    to { stroke-dashoffset: 0; }
  }
</style>
