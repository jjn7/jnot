---
import { Font } from 'astro:assets';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  /** Path of the share image, relative to the site root. */
  image?: string;
  /** Case study pages link sections back to the home page. */
  home?: boolean;
  type?: 'website' | 'article';
}

const {
  title = site.title,
  description = site.description,
  image = '/og-image.png',
  home = true,
  type = 'website',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#060a09" />
    <meta name="author" content={site.name} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="jnot.net" />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="The jnot.net logo with the words Joel Nottle, web designer and developer" />
    <meta name="twitter:card" content="summary_large_image" />

    <Font cssVariable="--font-sans" preload={[{ weight: '300 700', style: 'normal', subset: 'latin' }]} />
    <Font cssVariable="--font-mono" />

    <slot name="head" />

    <!-- Google Analytics 4: loaded after the page so it never slows the first paint -->
    <script is:inline define:vars={{ gaId: site.gaId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', gaId);
      addEventListener('load', () => {
        const s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=' + gaId;
        document.head.appendChild(s);
      });
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header home={home} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  .skip {
    position: fixed;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 50;
    padding: 0.6rem 1rem;
    border-radius: 6px;
    background: var(--lime);
    color: var(--ink);
    font-weight: 600;
    text-decoration: none;
    transform: translateY(-200%);
  }
  .skip:focus { transform: none; }
  main:focus { outline: none; }
</style>
