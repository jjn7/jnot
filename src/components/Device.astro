---
/**
 * A screenshot in a desktop-browser or phone frame.
 * With no image it renders a labelled placeholder (flagged for the launch check).
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  kind: 'desktop' | 'mobile';
  image?: ImageMetadata;
  alt: string;
  /** `sizes` attribute: how wide the frame renders at each breakpoint. */
  sizes: string;
  /** Eager-load images above the fold. */
  eager?: boolean;
  /** Used in the placeholder so it's obvious which file to add. */
  projectId: string;
}

const { kind, image, alt, sizes, eager = false, projectId } = Astro.props;
const widths = kind === 'desktop' ? [480, 800, 1200, 1600] : [260, 400, 600, 780];
---

<figure class:list={['device', kind]}>
  {kind === 'desktop' && (
    <div class="chrome" aria-hidden="true"><i></i><i></i><i></i></div>
  )}
  <div class="screen">
    {
      image ? (
        <Image
          src={image}
          alt={alt}
          widths={widths.filter((w) => w <= image.width)}
          sizes={sizes}
          format="webp"
          quality={82}
          loading={eager ? 'eager' : 'lazy'}
          fetchpriority={eager ? 'high' : undefined}
          decoding="async"
        />
      ) : (
        <div class="placeholder todo" data-todo={`${projectId}: ${kind} screenshot`}>
          <span>
            {kind} screenshot
            <br />
            <small>src/content/projects/{projectId}/{kind}.webp</small>
          </span>
        </div>
      )
    }
  </div>
</figure>

<style>
  .device {
    position: relative;
    overflow: hidden;
    background: var(--ink-3);
    border: 1px solid var(--line-strong);
    box-shadow: 0 18px 40px -18px rgb(0 0 0 / 0.7);
  }
  .desktop { border-radius: var(--radius); }
  .chrome {
    display: flex;
    gap: 5px;
    align-items: center;
    height: clamp(16px, 2.2vw, 24px);
    padding-inline: 0.6rem;
    background: #0d1816;
    border-bottom: 1px solid var(--line);
  }
  .chrome i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--line-strong);
  }
  .mobile {
    border: 5px solid #18221f;
    border-radius: clamp(14px, 2.4vw, 26px);
    outline: 1px solid var(--line-strong);
  }

  .screen :global(img),
  .placeholder {
    width: 100%;
    object-fit: cover;
    object-position: top;
  }
  .desktop .screen :global(img),
  .desktop .placeholder { aspect-ratio: 16 / 10; }
  .mobile .screen :global(img),
  .mobile .placeholder { aspect-ratio: 390 / 844; }

  .placeholder {
    display: grid;
    place-items: center;
    padding: 0.75rem;
    text-align: center;
    line-height: 1.5;
    border: 0;
    background:
      repeating-linear-gradient(135deg, transparent 0 10px, rgb(95 163 156 / 0.05) 10px 11px),
      var(--ink-2);
  }
  .placeholder small {
    display: block;
    margin-top: 0.3rem;
    color: var(--muted);
    font-size: 0.7rem;
    word-break: break-all;
  }
  .mobile .placeholder { font-size: 0.65rem; }
  .mobile .placeholder small { display: none; }
</style>
