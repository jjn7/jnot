---
import Logo from '../components/Logo.astro';
import Frame from '../components/Frame.astro';
import { site } from '../data/site';
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <Frame animate />
  <div class="wrap inner">
    <div class="mark">
      <Logo animate label="jnot.net" />
    </div>
    <p class="hello mono">Hi, I’m <strong>{site.name}</strong>.</p>
    <h1 id="hero-title">
      {site.hook}<span class="caret" aria-hidden="true">▮</span>
    </h1>
    <p class="lede">{site.lede}</p>
    <p class="availability">
      <span class="dot" aria-hidden="true"></span>
      {site.availability}
    </p>
    <div class="actions">
      <a class="btn btn-primary" href="#work">View work <span class="arrow" aria-hidden="true">↓</span></a>
      <a class="btn" href="#contact">Get in touch</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    align-items: center;
    min-height: calc(100svh - var(--header-h));
    padding-block: clamp(3.5rem, 9vh, 6rem);
    text-align: center;
    --frame-colour: var(--teal);
  }
  .inner {
    display: grid;
    justify-items: center;
    gap: clamp(1rem, 2.6vh, 1.6rem);
  }
  .mark {
    width: clamp(9.5rem, 30vw, 15rem);
    margin-bottom: clamp(0.25rem, 2vh, 1rem);
  }
  .hello {
    font-size: var(--step--1);
    color: var(--sage);
    letter-spacing: 0.02em;
  }
  .hello strong { color: var(--teal-bright); font-weight: 500; }
  h1 {
    font-size: var(--step-4);
    max-width: 15ch;
    line-height: 1.04;
    letter-spacing: -0.035em;
  }
  .caret {
    color: var(--lime);
    font-weight: 400;
    margin-left: 0.06em;
    animation: blink 1.15s steps(1) infinite;
  }
  @keyframes blink {
    50% { opacity: 0; }
  }
  .lede {
    max-width: 36ch;
    font-size: var(--step-1);
    color: var(--mist);
    line-height: 1.5;
  }
  .availability {
    max-width: 52ch;
    font-family: var(--mono);
    font-size: var(--step--1);
    line-height: 1.7;
    color: var(--sage);
  }
  .dot {
    display: inline-block;
    margin-right: 0.55rem;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--spark);
    box-shadow: 0 0 0 0 rgb(70 227 166 / 0.5);
    animation: pulse 2.4s ease-out infinite;
    vertical-align: 0.05rem;
  }
  @keyframes pulse {
    0% { box-shadow: 0 0 0 0 rgb(70 227 166 / 0.45); }
    70%, 100% { box-shadow: 0 0 0 9px rgb(70 227 166 / 0); }
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }
</style>
